  "facts": [
    {
      "id": "school-act-87",
      "text": "学校教育法第 87 条は、大学の修業年限を 4 年とする",
      "text_en": "Article 87 of the School Education Act sets the standard length of a university course at 4 years",
      "source": "https://laws.e-gov.go.jp/api/1/articles;lawId=322AC0000000026;article=87",
      "read_on": "2026-11-26",
      "status": "confirmed",
      "quotes": [
        "大学の修業年限は、四年とする。"
      ],
      "how": "e-Gov 法令検索の API で、学校教育法（法令番号 322AC0000000026）の第八十七条を 2026-11-26 に開いて読んだ。"
    },
    {
      "id": "school-act-89",
      "text": "学校教育法第 89 条は、3 年以上在学し、卒業の要件の単位を優秀な成績で修得したと大学が認める学生の卒業を、大学が認めうるとする",
      "text_en": "Article 89 of the School Education Act lets a university allow a student who has been enrolled for 3 years or more, and whom it finds to have earned the credits for graduation with excellent results, to graduate",
      "source": "https://laws.e-gov.go.jp/api/1/articles;lawId=322AC0000000026;article=89",
      "read_on": "2026-11-26",
      "status": "confirmed",
      "quotes": [
        "大学は、文部科学大臣の定めるところにより、当該大学の学生（第八十七条第二項に規定する課程に在学するものを除く。）で当該大学に三年（同条第一項ただし書の規定により修業年限を四年を超えるものとする学部の学生にあつては、三年以上で文部科学大臣の定める期間）以上在学したもの（これに準ずるものとして文部科学大臣の定める者を含む。）が、卒業の要件として当該大学の定める単位を優秀な成績で修得したと認める場合には、同項の規定にかかわらず、その卒業を認めることができる。"
      ],
      "how": "e-Gov 法令検索の API で、学校教育法の第八十九条を 2026-11-26 に開いて読んだ。"
    },
    {
      "id": "school-act-104",
      "text": "学校教育法第 104 条は、大学が、大学を卒業した者に学士の学位を授与するとする",
      "text_en": "Article 104 of the School Education Act has a university confer the degree of bachelor (gakushi) on its graduates",
      "source": "https://laws.e-gov.go.jp/api/1/articles;lawId=322AC0000000026;article=104",
      "read_on": "2026-11-26",
      "status": "confirmed",
      "quotes": [
        "大学（専門職大学及び第百八条第二項の大学（以下この条において「短期大学」という。）を除く。以下この項及び第七項において同じ。）は、文部科学大臣の定めるところにより、大学を卒業した者に対し、学士の学位を授与するものとする。"
      ],
      "how": "e-Gov 法令検索の API で、学校教育法の第百四条を 2026-11-26 に開いて読んだ。"
    },
    {
      "id": "order-declaration",
      "text": "運営者の README は、OMSCS の修士号を、博士号の目標に向かう途上に置いている",
